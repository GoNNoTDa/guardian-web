{
  "manifest_version": 3,
  "name": "Guardián Web",
  "version": "0.3.0",
  "description": "Avisa cuando una web tiene actividad extraña o potencialmente dañina (phishing, malware, cryptojacking, exfiltración, scams).",
  "permissions": ["webRequest", "webNavigation", "tabs", "storage", "notifications", "sidePanel", "downloads", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-probe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Guardián Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
