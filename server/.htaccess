# Página de inicio.
DirectoryIndex index.html

# Denegar acceso público a la configuración y a las librerías internas.
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# (.*/)? para que también cubra /lib/ y /schema.sql en la raíz del dominio.
RedirectMatch 403 ^/(.*/)?lib/
RedirectMatch 403 ^/(.*/)?migrations/
RedirectMatch 403 \.sql$

# Páginas de error HTTP con la estética de Guardián Web.
ErrorDocument 400 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 405 /error.php
ErrorDocument 429 /error.php
ErrorDocument 500 /error.php
ErrorDocument 503 /error.php
